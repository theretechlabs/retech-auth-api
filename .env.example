# ==============================================
# Retech Auth API — variáveis de ambiente
# Copie para .env e ajuste. NUNCA commite o .env.
# Todas as variáveis abaixo são obrigatórias (ver internal/config/config.go).
# ==============================================

# ---------- SERVIDOR ----------
# Porta HTTP em que a API escuta (o Dockerfile expõe 8080)
PORT=8080
# Ambiente: development | staging | production
ENV=development

# ---------- BANCO DE DADOS ----------
# Host do PostgreSQL
DB_HOST=localhost
# Porta do PostgreSQL (5430 é a porta publicada pelo docker-compose.yml)
DB_PORT=5430
# Usuário do banco
DB_USER=retech_auth_user
# Senha do banco — use um valor forte; nunca reutilize a de produção em dev
DB_PASSWORD=change-me-db-password
# Nome do banco
DB_NAME=retech_auth_db
# sslmode do lib/pq: disable | require | verify-ca | verify-full (em produção use require ou superior)
DB_SSLMODE=disable

# ---------- JWT (RS256) ----------
# Diretório das chaves RSA (gerada automaticamente se vazio). Em produção, volume persistente ou secret.
JWT_RSA_KEYS_DIR=./keys
# Validade do access token em horas
JWT_EXPIRATION_HOURS=24
# Validade do refresh token em horas (deve ser maior que JWT_EXPIRATION_HOURS)
JWT_REFRESH_EXPIRATION_HOURS=168

# ---------- BOOTSTRAP (HMAC) ----------
# Secret compartilhado para /applications/sync e /password-reset/* via HMAC-SHA256. Gere com: openssl rand -base64 32
BOOTSTRAP_SECRET=change-me-generate-with-openssl-rand-base64-32

# ---------- CORS ----------
# Origens permitidas, separadas por vírgula (evite "*" quando credentials estiver habilitado)
CORS_ALLOWED_ORIGINS=http://localhost:3030

# ---------- DOCUMENTAÇÃO (Redoc) ----------
# Habilita a página /docs
DOCS_ENABLED=true
# Caminho do spec OpenAPI servido pela própria API
DOCS_SPEC_URL=/public/openapi-v1.yaml
# Título exibido na documentação
DOCS_TITLE=Retech Auth API
# Descrição exibida na documentação
DOCS_DESCRIPTION=Documentação dos serviços de autenticação e autorização Retech.
# Versão exibida na documentação
DOCS_VERSION=v1 (1.0.0)
# URL base da API exibida nos exemplos
DOCS_API_BASE_URL=http://localhost:8080/v1
# Links de versões no formato label:path, separados por vírgula
DOCS_VERSION_LINKS=v1:/docs/v1
# E-mail de suporte exibido no cabeçalho
DOCS_HERO_SUPPORT_EMAIL=suporte@example.com
# URL de suporte exibida no cabeçalho
DOCS_HERO_SUPPORT_URL=https://example.com
# Licença exibida no cabeçalho
DOCS_HERO_LICENSE=Proprietary

# ==============================================
# DOCKER COMPOSE (somente para o serviço postgres em docker-compose.yml)
# Não são lidas pela aplicação Go.
# ==============================================
# Nome do container do PostgreSQL
CONTAINER_NAME=retech-auth-db
# Host do PostgreSQL para ferramentas psql locais
PGHOST=localhost
# Usuário criado no container (mantenha igual a DB_USER)
PGUSER=retech_auth_user
# Senha criada no container (mantenha igual a DB_PASSWORD)
PGPASSWORD=change-me-db-password
# Banco criado no container (mantenha igual a DB_NAME)
PGDATABASE=retech_auth_db
# Porta publicada no host (mantenha igual a DB_PORT)
PGPORT=5430
# Diretório de dados dentro do container
PGDATA=/var/lib/postgresql/data/pgdata
# Nome do volume Docker
PGVOLUME_NAME=retech_auth_db_volume
# Nome da rede Docker
COMPOSE_NETWORK=retech-network
